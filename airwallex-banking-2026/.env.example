# Export these variables in your shell; .env files are not loaded automatically.
# Leave BOTH credentials unset to start the in-process local HTTP mock.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Optional when scoped credentials require a target account:
AIRWALLEX_LOGIN_AS=
# Existing issuing cardholder ID (required for card rail):
AIRWALLEX_CARDHOLDER_ID=
# Exact gateway merchant ID -> Airwallex merchant brand IDs (required for card rail):
AIRWALLEX_MERCHANT_BRANDS_JSON={"monitor-store":["REPLACE_WITH_MERCHANT_BRAND_ID"]}
# Exact gateway merchant ID -> pre-provisioned trusted sandbox beneficiary:
AIRWALLEX_BENEFICIARIES_JSON={"monitor-store":"REPLACE_WITH_BENEFICIARY_ID"}
INTENTPAY_PUBLIC_KEY_PATH=data/owner-public.pem
# Signing CLI only; never give this key to the agent/server:
INTENTPAY_PRIVATE_KEY_PATH=data/owner-private.pem
MCP_TOKEN=replace-with-a-long-random-secret
PORT=3001
AUDIT_PATH=data/audit.jsonl
# Optional; failure falls back to console. Never commit a real URL/secret.
SLACK_WEBHOOK_URL=
AIRWALLEX_WEBHOOK_SECRET=
