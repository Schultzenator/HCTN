{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentPay Signed Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "signature"
  ],
  "properties": {
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "budgetMinor",
        "baseCurrency",
        "targetCurrency",
        "merchants",
        "expiresAt",
        "feeReserveMinor"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "budgetMinor": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,14})$",
          "not": {
            "const": "0"
          }
        },
        "baseCurrency": {
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "PLN",
            "AUD",
            "SGD",
            "HKD",
            "CAD",
            "CHF",
            "JPY",
            "KWD"
          ]
        },
        "targetCurrency": {
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "PLN",
            "AUD",
            "SGD",
            "HKD",
            "CAD",
            "CHF",
            "JPY",
            "KWD"
          ]
        },
        "merchants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "humanAboveMinor": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,14})$"
        },
        "feeReserveMinor": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,14})$"
        }
      }
    }
  }
}
