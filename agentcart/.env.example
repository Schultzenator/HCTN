# AgentCart configuration — SANDBOX ONLY. Never put live credentials here.

# PayPal (sandbox). MOCK_PAYPAL=1 simulates the Orders API locally (no keys needed).
MOCK_PAYPAL=1
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Agent brain: "scripted" (default, no key) | "openai" | "mistral"
AGENT_MODE=scripted
OPENAI_API_KEY=
MISTRAL_API_KEY=

PORT=3000
