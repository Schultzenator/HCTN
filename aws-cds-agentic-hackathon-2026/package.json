{
  "name": "omniloop",
  "version": "0.1.0",
  "description": "OmniLoop - agentic omnichannel commerce on AWS CDS (EUM RCS/SMS, WhatsApp, SES) + Bedrock AgentCore",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "demo": "tsc && node dist/demo/scenario.js",
    "start": "tsc && node dist/server/webhook.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1154.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/credential-provider-node": "^3.972.87",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/signature-v4": "^5.7.4",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
