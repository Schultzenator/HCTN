{
  "name": "twitchcon-chat-relay-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Moderator-led cooperative Twitch stories with deterministic scenes",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "demo": "npm run build && node --env-file-if-exists=.env dist/src/index.js --fixture",
    "smoke": "npm run build && node dist/test/fixtureSmoke.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3"
  }
}
