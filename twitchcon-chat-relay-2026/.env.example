# Node 22: npm start / npm run demo automatically read .env from the project directory.
PORT=3210
SESSION_SEED=twitchcon-2026
# Live IRC: lowercase channel/login, no #; token belongs to TWITCH_USERNAME.
# Required USER access token scope: chat:read. Never commit real credentials.
TWITCH_CHANNEL=your_channel
TWITCH_USERNAME=your_bot_or_broadcaster_login
TWITCH_OAUTH_TOKEN=
