{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitOverride": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "forceConsistentCasingInFileNames": true,
    "outDir": "dist", "rootDir": ".", "sourceMap": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
